# Variables d'environnement — modèle sans aucune valeur secrète.
# Copier en .env.local (développement) ou les définir dans Vercel
# (Project → Settings → Environment Variables). Ne jamais versionner les valeurs.

# --- Site ---------------------------------------------------------------
# URL publique, sans barre finale (liens des e-mails, métadonnées)
NEXT_PUBLIC_BASE_URL=https://www.vh-besancon-alumni.fr

# --- Base de données (obligatoire en production) ---------------------------
# PostgreSQL : Neon via la Marketplace Vercel renseigne DATABASE_URL tout seul.
# En local, sans valeur : PostgreSQL embarqué dans .data/pglite (aucun Docker).
DATABASE_URL=
# Connexions simultanées par instance (défaut 5)
# DATABASE_POOL_SIZE=5

# --- Images (obligatoire en production sur Vercel) ------------------------
# Store Vercel Blob public. Sans jeton : fichiers dans MEDIA_DIR (local).
BLOB_READ_WRITE_TOKEN=
# MEDIA_DIR=.data/media
# STORAGE_DRIVER=fs

# --- Authentification ------------------------------------------------------
# Secret de signature des sessions : `openssl rand -base64 32`
AUTH_SECRET=
# Ancien nom accepté (même valeur)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.vh-besancon-alumni.fr
# Coût bcrypt des nouveaux hash (défaut 12 ; les hash plus faibles sont recalculés à la connexion)
# BCRYPT_COST=12

# Connexion Google (facultatif : le bouton disparaît sans ces valeurs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion LinkedIn (facultatif)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Administrateurs désignés à l'import (e-mails séparés par des virgules)
ADMIN_EMAILS=

# --- E-mails (Gmail de l'association, mot de passe d'application) ---------
EMAIL_USER=
EMAIL_PASSWORD=
# Destinataire des demandes d'inscription (défaut : EMAIL_USER)
ADMIN_EMAIL=
# smtp | log | outbox — par défaut : smtp seulement en production sur une vraie base
# EMAIL_TRANSPORT=
# EMAIL_OUTBOX_DIR=.data/outbox

# --- Tâches planifiées (Vercel Cron) ----------------------------------------
CRON_SECRET=

# --- Export des abonnés vers Google Drive (facultatif) --------------------
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# --- Statistiques ----------------------------------------------------------
# Comptes exclus des statistiques de visite (e-mails séparés par des virgules)
# STATS_EXCLUDED_EMAILS=

# --- Sentry (facultatif) ---------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Migration depuis Sanity (une seule fois, en local) --------------------
# Jeton Sanity en lecture seule (aucune écriture côté Sanity)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# --- Développement local uniquement ---------------------------------------
# Connexion sans mot de passe aux comptes @local.test (npm run db:seed-local)
# ALLOW_DEV_LOGIN=1
# AUTH_TRUST_HOST=true
